{
  "name": "junction-sbank-coach",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data": "npm run data:fetch && npm run data:prepare",
    "data:fetch": "tsx scripts/data/fetch.ts",
    "data:prepare": "tsx scripts/data/prepare.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1"
  }
}
